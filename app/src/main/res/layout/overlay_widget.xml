<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/toggleButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="#CC222222"
        android:gravity="center"
        android:text="OFF"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/debugPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#EE111111"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF88"
            android:textSize="12sp"
            android:text="Status: Waiting..." />

        <TextView
            android:id="@+id/packageLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Package: -" />

        <TextView
            android:id="@+id/questionLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Question: -" />

        <TextView
            android:id="@+id/answerLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Answer: -" />

        <TextView
            android:id="@+id/hintLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#888888"
            android:textSize="10sp"
            android:text="Tap = Start/Stop  ·  Long-press = panel  ·  Drag = move" />
    </LinearLayout>
</LinearLayout>
