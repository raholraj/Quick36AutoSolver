<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick36 AutoSolver"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:text="Checking permissions..." />

    <Button
        android:id="@+id/openSettingsBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="1. Enable Accessibility Service" />

    <Button
        android:id="@+id/enableOverlayBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Enable Floating Overlay" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#555555"
        android:text="After both steps:\n• The floating button appears on screen\n• Open Quick36 app\n• Tap the floating button → ON\n• It will auto-detect &amp; solve every question\n\nLong-press the button to see the debug panel.\nUse 'Set as Target' if package name is wrong." />

</LinearLayout>
